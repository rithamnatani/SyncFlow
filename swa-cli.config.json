{
  "$schema": "https://aka.ms/azure/static-web-apps-cli/schema",
  "configurations": {
    "sync-flow": {
      "appLocation": "client",
      "apiLocation": "api",
      "outputLocation": "client/dist/client",
      "apiLanguage": "dotnetisolated",
      "apiVersion": "6.0",
      "appBuildCommand": "bun run build",
      "apiBuildCommand": "dotnet publish -c Release",
      "run": "bun start",
      "appDevserverUrl": "http://localhost:4200",
      "apiDevserverUrl": "http://localhost:7071"
    }
  }
}